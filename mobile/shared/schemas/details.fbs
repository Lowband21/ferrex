// FlatBuffers schema: compact TMDB/detail payloads needed by mobile library grids
// and series bundles.

include "ids.fbs";

namespace ferrex.details;

table GenreInfo {
  id:   ulong;
  name: string (required);
}

table EnhancedMovieDetails {
  id:                   ulong;
  title:                string;
  original_title:       string;
  overview:             string;
  release_date:         string;
  runtime:              uint;
  vote_average:         float;
  vote_count:           uint;
  popularity:           float;
  content_rating:       string;
  genres:               [GenreInfo];
  homepage:             string;
  status:               string;
  tagline:              string;
  budget:               ulong;
  revenue:              ulong;
  poster_path:          string;
  backdrop_path:        string;
  logo_path:            string;
  primary_poster_iid:   ferrex.ids.Uuid;
  primary_backdrop_iid: ferrex.ids.Uuid;
}

table EnhancedSeriesDetails {
  id:                    ulong;
  name:                  string;
  original_name:         string;
  overview:              string;
  first_air_date:        string;
  last_air_date:         string;
  number_of_seasons:     ushort;
  number_of_episodes:    ushort;
  available_seasons:     ushort;
  available_episodes:    ushort;
  vote_average:          float;
  vote_count:            uint;
  popularity:            float;
  content_rating:        string;
  genres:                [GenreInfo];
  homepage:              string;
  status:                string;
  tagline:               string;
  in_production:         bool;
  poster_path:           string;
  backdrop_path:         string;
  logo_path:             string;
  primary_poster_iid:    ferrex.ids.Uuid;
  primary_backdrop_iid:  ferrex.ids.Uuid;
}

table SeasonDetails {
  id:                 ulong;
  season_number:      ushort;
  name:               string;
  overview:           string;
  air_date:           string;
  episode_count:      ushort;
  poster_path:        string;
  primary_poster_iid: ferrex.ids.Uuid;
  runtime:            uint;
}

table EpisodeDetails {
  id:                ulong;
  episode_number:    ushort;
  season_number:     ushort;
  name:              string;
  overview:          string;
  air_date:          string;
  runtime:           uint;
  still_path:        string;
  primary_still_iid: ferrex.ids.Uuid;
  vote_average:      float;
  vote_count:        uint;
  production_code:   string;
}
