// FlatBuffers schema: authentication and setup payloads for mobile clients.

include "ids.fbs";
include "common.fbs";

namespace ferrex.auth;

table LoginRequest {
  username:    string (required);
  password:    string (required);
  device_name: string;
}

table RegisterRequest {
  username:     string (required);
  password:     string (required);
  display_name: string (required);
}

enum SessionScope : byte {
  Full     = 0,
  Playback = 1,
}

table AuthToken {
  access_token:      string (required);
  refresh_token:     string (required);
  expires_in:        uint;
  session_id:        ferrex.ids.Uuid;
  device_session_id: ferrex.ids.Uuid;
  user_id:           ferrex.ids.Uuid;
  scope:             SessionScope = Full;
}

table RefreshRequest {
  refresh_token: string (required);
}

table PasswordPolicy {
  enforce:         bool;
  min_length:      ushort;
  require_uppercase: bool;
  require_lowercase: bool;
  require_number: bool;
  require_special: bool;
}

table PinPolicy {
  min_length:                 ushort;
  max_length:                 ushort;
  require_numeric:            bool;
  reject_repeated_digits:     bool;
  max_consecutive_identical:  ushort;
  reject_sequential_digits:   bool;
}

table DeviceTrustPolicy {
  remember_device_default:   bool;
  trust_duration_days:       ushort;
  pin_max_attempts:          ubyte;
  pin_lockout_minutes:       ushort;
  admin_pin_unlock_enabled:  bool;
}

table SetupStatus {
  needs_setup:          bool;
  has_admin:            bool;
  requires_setup_token: bool;
  user_count:           uint;
  library_count:        uint;
  admin_password_policy: PasswordPolicy;
  user_password_policy:  PasswordPolicy;
  pin_policy:            PinPolicy;
  device_trust_policy:   DeviceTrustPolicy;
}

table UserProfile {
  id:           ferrex.ids.Uuid (required);
  username:     string (required);
  display_name: string (required);
  avatar_url:   string;
  email:        string;
  created_at:   ferrex.common.Timestamp;
  updated_at:   ferrex.common.Timestamp;
  last_login:   ferrex.common.Timestamp;
  is_active:    bool = true;
}

root_type AuthToken;
