  "query": "\n            SELECT\n                id,\n                state::text AS \"state!\",\n                rule_hash,\n                evaluated_at,\n                expires_at,\n                error_message,\n                total_count,\n                visible_count\n            FROM collection_materializations\n            WHERE collection_id = $1\n            ORDER BY updated_at DESC, id DESC\n            LIMIT 1\n            ",
