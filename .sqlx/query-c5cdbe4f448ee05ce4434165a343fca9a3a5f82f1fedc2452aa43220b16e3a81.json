  "query": "\n            SELECT\n                item_key,\n                media_type::text AS \"media_type!\",\n                media_id,\n                title_snapshot,\n                subtitle_snapshot,\n                (ROW_NUMBER() OVER (ORDER BY position_key, id) - 1)::int AS \"position!\",\n                sort_key,\n                added_at,\n                added_by\n            FROM collection_manual_memberships\n            WHERE collection_id = $1\n            ORDER BY position_key, id\n            ",
