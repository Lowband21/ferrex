{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                mr.id,\n                mr.tmdb_id,\n                mr.title,\n                mr.theme_color,\n                mr.batch_id,\n                mf.id AS file_id,\n                mf.file_path,\n                mf.filename,\n                mf.file_size,\n                mf.discovered_at AS \"file_discovered_at!\",\n                mf.created_at AS \"file_created_at!\",\n                mf.technical_metadata,\n                mf.library_id\n            FROM movie_references mr\n            JOIN media_files mf ON mr.file_id = mf.id\n            WHERE mf.is_available = TRUE\n            ORDER BY mr.title\n            ",
